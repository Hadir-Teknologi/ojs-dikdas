# URL publik OJS, dipakai di config.inc.php base_url
APP_URL=https://jurnal.example.com

# Domain yang dijawab nginx (server_name). Boleh lebih dari satu, pisah spasi:
#   APP_DOMAIN="jurnal.example.com www.jurnal.example.com"
APP_DOMAIN=jurnal.example.com

APP_PORT=8080

DB_DRIVER=mysqli
DB_HOST=db
DB_NAME=ojs
DB_USER=ojs
DB_PASSWORD=ubah-password-ini
DB_ROOT_PASSWORD=ubah-root-password-ini

# Harus unik & rahasia, dipakai untuk hash password/session
SALT=ganti-dengan-string-acak-panjang

TIME_ZONE=Asia/Jakarta
# Off = tampilkan web installer (deploy pertama). Set On setelah instalasi selesai.
INSTALLED=Off
# On kalau sudah pakai HTTPS di depan container
FORCE_SSL=Off
MAX_UPLOAD_SIZE=20m

# Proxy di depan container mengakhiri TLS. Teruskan status https ke PHP
# supaya OJS tahu request aslinya https (penting untuk FORCE_SSL=On).
map $http_x_forwarded_proto $forwarded_https {
    default off;
    https   on;
}

server {
    listen 80;
    server_name ${APP_DOMAIN};
    root /var/www/html;
    index index.php;
    charset utf-8;

    # set real ip kalau di belakang reverse proxy
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    client_max_body_size ${MAX_UPLOAD_SIZE};
    autoindex off;

    # File internal OJS tidak boleh diakses langsung
    location ~ ^/(cache|registry|files)/ {
        deny all;
    }
    # Vendor berisi asset statis yang dipakai UI, tapi PHP-nya tidak boleh
    # dieksekusi langsung lewat URL.
    location ~ ^/lib/pkp/lib/vendor/.*\.php$ {
        deny all;
    }
    location ~ /\. {
        deny all;
    }
    location = /config.inc.php {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.php$uri;
    }

    # OJS 3.5 routing bergantung pada CGI PATH_INFO — wajib dikirim.
    # $path_info disimpan ke variabel sebelum try_files (try_files mereset
    # $fastcgi_path_info).
    location ~ \.php(/.*)?$ {
        fastcgi_split_path_info ^(.+\.php)(/.*)?$;
        set $path_info $fastcgi_path_info;
        try_files $fastcgi_script_name =404;

        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $path_info;
        fastcgi_param HTTPS $forwarded_https;
        fastcgi_param HTTP_HOST $http_host;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 120s;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    access_log /dev/stdout combined;
    error_log /dev/stderr warn;
}
